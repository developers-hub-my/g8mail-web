---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL } from '../consts';

interface Props {
    title?: string;
    description?: string;
    current?: 'home' | 'pricing' | 'docs';
}

const {
    title = 'Wau — Catch dev emails. Inspect everything. Never deliver.',
    description = 'Wau is a hosted SMTP sandbox that captures every email your app sends in development, staging and UAT. Inspect HTML, text, raw source, headers and attachments. Nothing is delivered.',
    current,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Wau" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        {/* Apply a pinned theme before first paint; no value means follow the system ("auto"). */}
        <script is:inline>
            try { var t = localStorage.getItem('wau-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <SiteHeader current={current} />
        <slot />
        <SiteFooter />

        <script>
            const root = document.documentElement;
            const syncTheme = () => {
                const cur = root.dataset.theme || 'system';
                document.querySelectorAll<HTMLElement>('[data-set-theme]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === cur)));
            };

            document.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;

                const themeBtn = target.closest<HTMLElement>('[data-set-theme]');
                if (themeBtn) {
                    const v = themeBtn.dataset.setTheme!;
                    if (v === 'system') delete root.dataset.theme;
                    else root.dataset.theme = v;
                    try {
                        v === 'system' ? localStorage.removeItem('wau-theme') : localStorage.setItem('wau-theme', v);
                    } catch {}
                    syncTheme();
                }

                const menuBtn = target.closest<HTMLElement>('[data-menu-toggle]');
                if (menuBtn) {
                    const panel = document.getElementById(menuBtn.getAttribute('aria-controls')!)!;
                    panel.hidden = !panel.hidden;
                    menuBtn.setAttribute('aria-expanded', String(!panel.hidden));
                }

                const copyBtn = target.closest<HTMLElement>('[data-copy]');
                if (copyBtn) {
                    const src = document.getElementById(copyBtn.dataset.copy!)!;
                    navigator.clipboard?.writeText(src.innerText).catch(() => {});
                    const label = copyBtn.querySelector<HTMLElement>('[data-label]') || copyBtn;
                    const old = label.textContent;
                    label.textContent = 'Copied';
                    setTimeout(() => (label.textContent = old), 1400);
                }
            });

            // WAI-ARIA tabs: click, arrow keys, Home/End, roving tabindex.
            document.querySelectorAll('[role="tablist"]').forEach((list) => {
                const tabs = Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]'));
                const select = (tab: HTMLElement, focus = false) => {
                    tabs.forEach((t) => {
                        const on = t === tab;
                        t.setAttribute('aria-selected', String(on));
                        t.tabIndex = on ? 0 : -1;
                        const panel = document.getElementById(t.getAttribute('aria-controls')!);
                        if (panel) panel.hidden = !on;
                    });
                    if (focus) tab.focus();
                };
                tabs.forEach((t, i) => {
                    t.addEventListener('click', () => select(t));
                    t.addEventListener('keydown', (e) => {
                        const n = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
                        if (n === undefined) return;
                        e.preventDefault();
                        select(tabs[(n + tabs.length) % tabs.length], true);
                    });
                });
            });

            syncTheme();
        </script>
    </body>
</html>
