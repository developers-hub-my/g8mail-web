---
import WauMark from './WauMark.astro';
import { CONSOLE_URL, CONTACT_EMAIL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-foot">
    <div class="wrap">
        <div>
            <a class="logo" href="/" aria-label="Wau home"><WauMark />Wau</a>
            <p style="margin-top:12px;max-width:34ch">A hosted SMTP sandbox for development, staging and UAT mail. Wau by G8Suite.</p>
        </div>
        <div>
            <h2>Product</h2>
            <ul>
                <li><a href="/#inspector">Inspector</a></li>
                <li><a href="/pricing">Pricing</a></li>
                <li><a href="/docs">Docs</a></li>
                <li><a href="/docs#api">REST API</a></li>
            </ul>
        </div>
        <div>
            <h2>Console</h2>
            <ul>
                <li><a href={`${CONSOLE_URL}/login`}>Sign in</a></li>
                <li><a href={`${CONSOLE_URL}/register`}>Create an account</a></li>
            </ul>
        </div>
        <div>
            <h2>Company</h2>
            <ul>
                <li><a href="https://g8suite.com">G8Suite</a></li>
                <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
                <li>&copy; {year} <a href="https://devhub.my">Developers Hub Sdn Bhd</a></li>
            </ul>
        </div>
    </div>
</footer>
