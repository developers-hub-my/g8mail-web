---
const faqs = [
    {
        q: 'Does Wau deliver mail to real inboxes?',
        a: 'No — that’s the whole point. Wau accepts every message your app sends and stores it for inspection. Nothing ever leaves the box. When you’re ready for production, edit your .env to point at whatever real SMTP / mail provider you use. Wau is not in the production wire path.',
    },
    {
        q: 'Can I self-host Wau?',
        a: 'Not at the moment — Wau is offered as a fully managed cloud service. We run the infrastructure, backups, and upgrades so you can focus on shipping. If your organisation needs a dedicated or on-premise deployment, talk to us at hello@waumail.my.',
    },
    {
        q: 'Do I need a Wau SDK?',
        a: 'No. Wau speaks standard SMTP for capture and a documented REST API for inspection. Your app keeps using its existing framework mailer — just point MAIL_HOST at Wau. For programmatic inspection or HTTP-based sending, use the REST endpoints from any language.',
    },
    {
        q: 'What about an HTTP send option for environments where SMTP is blocked?',
        a: 'Wau exposes a JSON POST endpoint that accepts the same message shape (from, to, subject, html, text, attachments) so apps in serverless or restricted-egress environments can still capture mail without opening port 587.',
    },
    {
        q: 'Is the sandbox safe for production-shaped data?',
        a: 'Sandbox is for dev, staging, and UAT traffic. Messages are workspace-scoped with API token auth and can be encrypted at rest. Production sends go directly to your real provider — never through Wau.',
    },
];
---

<section id="faq" class="border-t border-zinc-200 py-20 sm:py-28 dark:border-white/5">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <p class="text-sm font-medium uppercase tracking-wider text-amber-600 dark:text-amber-500">FAQ</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
                Questions, answered straight.
            </h2>
        </div>

        <div class="mt-14 divide-y divide-zinc-200 dark:divide-white/5" id="faq-list">
            {
                faqs.map((faq, i) => (
                    <div class="py-5">
                        <button class="flex w-full cursor-pointer items-center justify-between text-left" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-answer-${i}`}>
                            <span class="text-base font-medium text-zinc-900 dark:text-white">{faq.q}</span>
                            <svg class={`ml-4 h-5 w-5 flex-shrink-0 text-zinc-400 transition-transform ${i === 0 ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <div id={`faq-answer-${i}`} class="mt-3 pr-10 text-zinc-600 dark:text-zinc-400" hidden={i !== 0}>
                            {faq.a}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    const items = document.querySelectorAll<HTMLElement>('#faq-list > div');

    items.forEach((item) => {
        const button = item.querySelector('button')!;
        const answer = item.querySelector<HTMLElement>('[id^="faq-answer"]')!;
        const chevron = item.querySelector('svg')!;

        button.addEventListener('click', () => {
            const isOpen = !answer.hidden;
            // Close all, then open the clicked one (accordion behaviour, matches the app).
            items.forEach((other) => {
                other.querySelector<HTMLElement>('[id^="faq-answer"]')!.hidden = true;
                other.querySelector('svg')!.classList.remove('rotate-180');
                other.querySelector('button')!.setAttribute('aria-expanded', 'false');
            });
            if (!isOpen) {
                answer.hidden = false;
                chevron.classList.add('rotate-180');
                button.setAttribute('aria-expanded', 'true');
            }
        });
    });
</script>
