---
import WauMark from './WauMark.astro';
import { CONSOLE_URL } from '../consts';
---

<nav class="fixed top-0 z-50 w-full border-b border-zinc-200 bg-white/80 backdrop-blur-md dark:border-white/5 dark:bg-[#0B1120]/80">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            {/* Wordmark */}
            <a href="/" class="flex items-center gap-2.5">
                <WauMark class="h-8 w-8 text-amber-500" />
                <span class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Wau</span>
            </a>

            {/* Center nav */}
            <div class="hidden items-center gap-8 md:flex">
                <a href="#features" class="text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Features</a>
                <a href="#pricing" class="text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Pricing</a>
                <a href="#faq" class="text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">FAQ</a>
                <a href={`${CONSOLE_URL}/docs`} class="text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Docs</a>
            </div>

            {/* Auth */}
            <div class="flex items-center gap-3">
                <a href={`${CONSOLE_URL}/login`} class="hidden text-sm font-medium text-zinc-600 transition hover:text-zinc-900 sm:inline-block dark:text-zinc-400 dark:hover:text-white">
                    Sign in
                </a>
                <a href={`${CONSOLE_URL}/register`} class="inline-flex items-center justify-center rounded-md bg-amber-500 px-4 py-2 text-sm font-medium text-zinc-950 shadow-sm transition hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-[#0B1120]">
                    Try Cloud
                </a>
            </div>
        </div>
    </div>
</nav>
